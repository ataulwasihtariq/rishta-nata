141 0 obj
<< /JS (\nvar TINT = ["RGB", 0.937, 0.957, 0.988];\nvar GREY = ["RGB", 0.886, 0.886, 0.886];\nvar NIL_RECEIVED = "Nil \(nothing\)";\nvar NIL_DETAILS = "Nil - nothing has been received so far";\n\nfunction _g\(n\) { try { return this.getField\(n\); } catch \(e\) { return null; } }\nfunction _val\(n\) { var f = _g\(n\); return f ? f.value : "Off"; }\n\nfunction _en\(n, on, clear\) {\n    var f = _g\(n\); if \(!f\) return;\n    f.readonly = !on;\n    f.fillColor = on ? TINT : GREY;\n    if \(!on && clear && f.value != ""\) f.value = "";\n}\nfunction _enb\(n, on, clear\) {\n    var f = _g\(n\); if \(!f\) return;\n    f.readonly = !on;\n    if \(!on && clear && f.value != "Off"\) f.value = "Off";\n}\nfunction _auto\(n, lock, text, clear\) {\n    var f = _g\(n\); if \(!f\) return;\n    f.readonly = lock;\n    f.fillColor = TINT;\n    if \(!clear\) return;\n    if \(lock\) { if \(f.value != text\) f.value = text; }\n    else if \(f.value == text\) f.value = "";\n}\n\nfunction syncForm\(clear\) {\n    _en\("bride_ahmadi_years", _val\("bride_ahmadi"\) == "since", clear\);\n    _en\("groom_ahmadi_years", _val\("groom_ahmadi"\) == "since", clear\);\n    var unpaid = _val\("mahr_paid"\) == "unpaid";\n    _auto\("mahr_received", unpaid, NIL_RECEIVED, clear\);\n    _auto\("mahr_details", unpaid, NIL_DETAILS, clear\);\n    var notFirst = _val\("groom_marriage_no"\) != "first";\n    _enb\("groom_firstwife", notFirst, clear\);\n    _en\("groom_nikah_ordinal", notFirst, clear\);\n}\nsyncForm\(false\);\n) /S /JavaScript >>
endobj
